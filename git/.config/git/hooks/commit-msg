#!/bin/sh
# Global commit-msg: strip AI attribution trailers, enforce conventional
# commits with commitlint, then chain to the repo's own hook.
set -u

msg_file="$1"

# Strip AI attribution from any tool (Claude, Gemini, Copilot, ...)
tmp="$msg_file.noai"
grep -viE '^[[:space:]]*(co-authored-by:.*(claude|gemini|copilot|chatgpt|openai|codex|opencode|cursor|ai@|assistant)|.*generated with \[?claude|.*generated by (ai|claude|gemini|copilot))' "$msg_file" > "$tmp" && mv "$tmp" "$msg_file"

if command -v commitlint >/dev/null 2>&1; then
  if ! commitlint --config "$HOME/.config/commitlint/commitlint.config.mjs" --edit "$msg_file"; then
    echo >&2 "commitlint: commit message does not follow conventional commits (bypass with --no-verify)"
    exit 1
  fi
fi

# --git-dir, not --git-path hooks: the latter resolves core.hooksPath back to
# this script and recurses forever.
local_hook="$(git rev-parse --git-dir)/hooks/commit-msg"
if [ -x "$local_hook" ] && [ ! "$local_hook" -ef "$0" ]; then
  exec "$local_hook" "$@"
fi
