
theme = Tokyo Night
font-family = JetBrainsMono Nerd Font
font-feature = -calt
font-feature = -liga
font-feature = -dlig
font-size = 13

window-padding-x = 10

window-padding-y = 10

background-opacity = 0.96

background-blur = 20

# nvim paints an explicit bg on every cell; without this it stays opaque
# while the shell is translucent
background-opacity-cells = true

cursor-style = block

cursor-style-blink = false

macos-titlebar-style = hidden

macos-option-as-alt = true

copy-on-select = false

shell-integration = zsh

confirm-close-surface = false

quit-after-last-window-closed = true

# readability
adjust-cell-height = 8%
font-thicken = true
window-padding-balance = true
window-padding-color = extend
mouse-hide-while-typing = true

# drop-down terminal from anywhere (needs Accessibility permission); it runs
# zsh, so it attaches to the same tmux "main" session
quick-terminal-position = top
quick-terminal-animation-duration = 0.12
keybind = global:ctrl+grave_accent=toggle_quick_terminal

# cursor trail (Neovide-like), Tokyo Night blue; see shaders/cursor_warp.glsl
custom-shader = shaders/cursor_warp.glsl
