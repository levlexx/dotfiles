% doctl, digitalocean, droplets

# List droplets
doctl compute droplet list --format ID,Name,PublicIPv4,Region,Size,Status,Tags

# SSH into a droplet
doctl compute ssh <droplet>

# Create a droplet
doctl compute droplet create <name> --region <region> --size <size> --image <image> --ssh-keys <ssh_key> --wait

# Power cycle / reboot a droplet
doctl compute droplet-action <action> <droplet> --wait

# Snapshot a droplet (before a migration or resize)
doctl compute droplet-action snapshot <droplet> --snapshot-name <snapshot_name> --wait

# Resize a droplet (power off first; --resize-disk is permanent)
doctl compute droplet-action resize <droplet> --size <size> --wait

# Delete a droplet
doctl compute droplet delete <droplet>

# Firewalls
doctl compute firewall list

# Reserved IPs
doctl compute reserved-ip list

$ droplet: doctl compute droplet list --format ID,Name,PublicIPv4,Status --no-header --- --column 1
$ action: printf '%s\n' reboot power-cycle power-off power-on shutdown
$ region: doctl compute region list --format Slug,Name,Available --no-header --- --column 1
$ size: doctl compute size list --format Slug,Memory,VCPUs,Disk,PriceMonthly --no-header --- --column 1
$ image: doctl compute image list-distribution --format Slug,Distribution,Name --no-header --- --column 1
$ ssh_key: doctl compute ssh-key list --format ID,Name --no-header --- --column 1


% doctl, digitalocean, app platform

# List apps
doctl apps list --format ID,Spec.Name,DefaultIngress,ActiveDeployment.Phase

# Runtime logs (follow)
doctl apps logs <app> --type run --follow

# Build logs of the latest deployment
doctl apps logs <app> --type build

# Redeploy
doctl apps create-deployment <app> --wait

# Deployments of an app
doctl apps list-deployments <app>

# Export the app spec
doctl apps spec get <app> > app.yaml

# Validate and apply a spec
doctl apps spec validate app.yaml && doctl apps update <app> --spec app.yaml

# Console into a running component
doctl apps console <app> <component>

$ app: doctl apps list --format ID,Spec.Name --no-header --- --column 1


% doctl, digitalocean, kubernetes

# List clusters
doctl kubernetes cluster list

# Save kubeconfig (then kctx / k9s)
doctl kubernetes cluster kubeconfig save <cluster>

# Node pools
doctl kubernetes cluster node-pool list <cluster>

# Log docker in to the container registry
doctl registry login

# Registry repositories and tags
doctl registry repository list-v2

# Garbage-collect the registry
doctl registry garbage-collection start --include-untagged-manifests

$ cluster: doctl kubernetes cluster list --format Name --no-header


% doctl, digitalocean, databases, dns, spaces

# Managed databases
doctl databases list --format ID,Name,Engine,Version,Region,Status

# Trusted sources (who can connect)
doctl databases firewalls list <database>

# Allow a droplet to connect
doctl databases firewalls append <database> --rule droplet:<droplet>

# Backups
doctl databases backups <database>

# DNS records of a domain
doctl compute domain records list <domain>

# Add an A record
doctl compute domain records create <domain> --record-type A --record-name <name> --record-data <ip>

# Spaces access keys
doctl spaces keys list

# Account and balance
doctl account get && doctl balance get

$ database: doctl databases list --format ID,Name,Engine --no-header --- --column 1
$ droplet: doctl compute droplet list --format ID,Name --no-header --- --column 1
$ domain: doctl compute domain list --format Domain --no-header


% doctl, digitalocean, auth

# Bind this repo to a doctl context (.envrc)
doinit

# Switch the global context
doctx

# Add a context (token from cloud.digitalocean.com/account/api/tokens)
doctl auth init --context <name>

# List contexts
doctl auth list
