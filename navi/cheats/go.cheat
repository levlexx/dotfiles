% go, profiling

# Add the debug server (pprof, fgprof, flight recorder) to this module
gprof init

# CPU profile of a running service (flame graph in the browser)
gprof cpu <seconds>

# Heap in use / all allocations since start
gprof <mem_kind>

# Wall-clock profile: CPU plus time blocked on I/O, DB, locks
gprof fgprof <seconds>

# Goroutines (leaks: the count keeps growing between two captures)
gprof goroutine

# Lock contention / blocking
gprof <contention_kind>

# Execution trace: GC pauses, scheduler latency, blocking
gprof trace <seconds>

# Flight recorder: the last ~10s, grab right after a latency spike
gprof flight

# Profile a pod (port-forwards first)
gprof cpu <seconds> -k <k8s_target>

# Compare two profiles (what changed after the fix)
gprof diff <base_profile> <new_profile>

# Load while profiling: 50 connections for 30s with a live TUI
oha -c 50 -z 30s <url>

$ mem_kind: printf '%s\n' heap allocs
$ contention_kind: printf '%s\n' mutex block
$ seconds: printf '%s\n' 30 10 60 5
$ k8s_target: kubectl get deploy,pod --no-headers -o name
$ base_profile: gprof ls
$ new_profile: gprof ls


% go, benchmarks

# Benchmark with before/after comparison (benchstat vs the previous run)
gbench <regex> <package>

# Compare the two newest runs
gbench cmp

# CPU + memory profile of one benchmark
gbench prof <regex> <package>

# Benchmark template (Go 1.24+ b.Loop)
printf '%s\n' 'func BenchmarkX(b *testing.B) {' '	b.ReportAllocs()' '	for b.Loop() {' '		X()' '	}' '}'

$ package: go list ./... | sed "s|^$(go list -m)|.|"


% go, compiler

# Escape analysis: what moves to the heap and why (nvim: <leader>ce)
go build -gcflags='-m=2' <package> 2>&1 | grep -E 'escapes|moved to heap'

# Inlining decisions
go build -gcflags='-m' <package> 2>&1 | grep -E 'can inline|inlining call'

# Bounds checks the compiler could not remove
go build -gcflags='-d=ssa/check_bce/debug=1' <package>

# Binary size by package/symbol
go tool nm -size -sort size <binary> | head -40

# Build with PGO: put a production CPU profile at default.pgo in the main package
cp <cpu_profile> <main_dir>/default.pgo && go build -pgo=auto ./...

$ package: go list ./... | sed "s|^$(go list -m)|.|"
$ cpu_profile: ls -1t .prof/*cpu*.pb.gz
$ main_dir: go list -f '{{if eq .Name "main"}}{{.Dir}}{{end}}' ./... | sed "s|^$(pwd)|.|"


% go, memory and gc tuning

# Soft memory limit for a container (≈ 90% of the limit); GC works harder near it
GOMEMLIMIT=<limit>MiB GOGC=100 ./<binary>

# Print every GC cycle (heap size, pause, CPU share)
GODEBUG=gctrace=1 ./<binary>

# Race detector on tests
go test -race ./...

# Goroutine leaks in tests (go.uber.org/goleak), in TestMain:
printf '%s\n' 'func TestMain(m *testing.M) { goleak.VerifyTestMain(m) }'


% go, production profiling

# Cloud Run: Cloud Profiler (continuous CPU/heap, free); call in main()
printf '%s\n' 'if err := profiler.Start(profiler.Config{Service: os.Getenv("K_SERVICE"), ServiceVersion: os.Getenv("K_REVISION")}); err != nil { slog.Warn("profiler", "err", err) }'

# Cloud Run: enable the API and grant the service account the agent role
gcloud services enable cloudprofiler.googleapis.com && gcloud projects add-iam-policy-binding $(gcloud config get project) --member serviceAccount:<sa> --role roles/cloudprofiler.agent

# Local Pyroscope server (UI on :4040) for continuous profiling in k3d/DO
pyroscope server

# Pyroscope Go SDK: push profiles from the service
printf '%s\n' 'pyroscope.Start(pyroscope.Config{ApplicationName: "<app>", ServerAddress: os.Getenv("PYROSCOPE_URL")})'

$ sa: gcloud iam service-accounts list --format='value(email)'


% go, debugging

# Debug image + delve in a pod / Docker
dlvk init

# Port-forward delve from a pod, then nvim: <leader>dc -> Attach Delve in container
dlvk <k8s_target>

# Delve headless for any process on this machine (nvim: Attach remote Delve :38697)
dlv debug --headless --listen=127.0.0.1:38697 --api-version=2 --accept-multiclient <package>

# Core dump on crash, then inspect
GOTRACEBACK=crash ./<binary>

$ k8s_target: kubectl get deploy,pod --no-headers -o name
$ package: go list ./... | sed "s|^$(go list -m)|.|"
